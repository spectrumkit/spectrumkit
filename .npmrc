# pnpm 10 flipped this default to `false`. Every workspace dep here is declared
# `workspace:*` (which pnpm links regardless), so this is a guard rather than
# load-bearing today: it keeps a plain-semver dep on a workspace package (e.g.
# the `0.0.x` peer range in spectrumkit-siwe-next-auth) resolving to the local
# package instead of silently fetching from the registry.
link-workspace-packages = true

# Publish scoped packages publicly. Redundant with `publishConfig.access` in
# both publishable packages, but this is the workspace-wide fallback for any
# new scoped package that forgets it -- npm defaults scoped packages to
# `restricted`, and a missed `access` is a failed publish, not a warning.
access = public

# Downgrades pnpm's packageManager-pin enforcement from throw to warn. Inert as
# long as `packageManager` stays on pnpm and `package-manager-strict-version`
# stays at its default of false; it only bites if the pin drifts from the pnpm
# actually running. Removing it re-arms a hard failure, so it stays.
package-manager-strict = false

# Keep one flat node_modules across the workspace, so peer-dep closures don't
# fragment into a separate wagmi/@wagmi/connectors copy per workspace package.
#
# This does NOT by itself guarantee a single copy of anything: hoisting gives one
# version the root slot and nests the rest (e.g. clsx is 1.2.1 at the root while
# spectrumkit's own 2.1.1 sits nested). What actually pins the stateful
# singletons -- wagmi, react, @tanstack/react-query, @walletconnect/* -- is the
# `pnpm.overrides` block in the root package.json. Both matter; neither is
# sufficient alone. Don't drop the overrides assuming this line covers you.
#
# Tradeoff: hoisting also disables pnpm's phantom-dependency detection.
node-linker = hoisted
