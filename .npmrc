link-workspace-packages = true
shamefully-hoist = false
shared-workspace-shrinkwrap = true
access = public
enable-pre-post-scripts = true
package-lock = true
strict-peer-dependencies = false
dedupe-peer-dependents = true
resolve-peers-from-workspace-root = true
package-manager-strict = false
# Use a single flat node_modules across the workspace so peer-dep contexts
# don't fragment. Without this, pnpm creates separate wagmi/@wagmi/connectors
# copies for each workspace package depending on which optional peers
# (@coinbase/wallet-sdk, @base-org/account, etc.) are resolvable in that
# package's closure. Two wagmi copies = two React Context instances =
# WagmiProviderNotFoundError at runtime.
node-linker = hoisted
