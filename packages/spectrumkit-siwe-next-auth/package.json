{
  "name": "@spectrumkit/spectrumkit-siwe-next-auth",
  "version": "0.0.2",
  "description": "SpectrumKit authentication adapter for Sign-In with Ethereum and NextAuth",
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=12.4"
  },
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "dev": "pnpm build:watch & pnpm typegen:watch",
    "prepare": "pnpm build",
    "prebuild": "pnpm clean:dist && pnpm typegen",
    "clean:dist": "rm -rf dist",
    "typecheck": "pnpm tsc --noEmit",
    "typegen": "tsc --emitDeclarationOnly",
    "typegen:watch": "tsc --emitDeclarationOnly --watch"
  },
  "keywords": [],
  "author": "SpectrumKit",
  "license": "MIT",
  "peerDependencies": {
    "@spectrumkit/spectrumkit": "0.0.x",
    "next-auth": ">=4.21.0 <5",
    "react": ">=18",
    "viem": "2.x"
  },
  "devDependencies": {
    "@spectrumkit/spectrumkit": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectrumkit/spectrumkit.git",
    "directory": "packages/spectrumkit-siwe-next-auth"
  }
}
