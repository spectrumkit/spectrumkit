{
  "name": "spectrumkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --recursive --parallel --filter @spectrumkit/spectrum* --filter example dev",
    "dev:lib": "pnpm --parallel --filter @spectrumkit/spectrum* dev",
    "dev:example": "pnpm dev:lib & pnpm --filter example dev",
    "build": "pnpm --recursive build",
    "start": "pnpm dev",
    "lint": "biome lint . && pnpm format:check && pnpm --recursive typecheck",
    "lint:fix": "biome lint . --write && pnpm format:fix",
    "format:check": "biome check .",
    "format:fix": "biome format . --write",
    "fetch:wallets": "node ./scripts/walletRegistry.js",
    "test": "pnpm test:unit",
    "test:unit": "vitest",
    "test:update": "vitest --update",
    "test:watch": "vitest --watch",
    "changeset": "changeset",
    "clean": "rm -rf ./packages/spectrumkit/dist ./packages/spectrumkit-siwe-next-auth/dist ./packages/spectrumkit/node_modules && pnpm install",
    "clean:untracked": "git clean -fxd -e '.env.local' -e '.env' && pnpm install",
    "release": "pnpm release:verify-git && pnpm release:build && changeset publish --tag latest",
    "release:verify-git": "git diff --exit-code HEAD && test -z \"$(git status --porcelain)\" && git rev-parse --abbrev-ref HEAD | grep -qx main",
    "release:build": "pnpm clean && pnpm lint && pnpm test && MINIFY_CSS=true pnpm --recursive build && cp README.md packages/spectrumkit/README.md",
    "release:test": "pnpm release:build && pnpm --filter example dev",
    "ci:example": "pnpm --filter @spectrumkit/spectrum* prepare && pnpm --filter example build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectrumkit/spectrumkit.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@tanstack/react-query": "5.102.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "next": "^16.2.11",
    "next-auth": "4.24.15",
    "postcss": "^8.5.16",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recursive-readdir-files": "^2.3.1",
    "typescript": "7.0.2",
    "viem": "2.55.19",
    "vite": "^8.1.0",
    "vitest": "4.1.11",
    "wagmi": "3.7.6"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "bufferutil",
      "msw",
      "protobufjs",
      "sharp",
      "utf-8-validate"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "@tanstack/react-query": "5.102.2",
      "viem": "2.55.19",
      "wagmi": "3.7.6",
      "@base-org/account": "2.5.10",
      "ws": "^8.21.0",
      "postcss": "^8.5.19",
      "@walletconnect/core": "2.23.10",
      "@walletconnect/utils": "2.23.10",
      "@walletconnect/types": "2.23.10",
      "@walletconnect/sign-client": "2.23.10",
      "@walletconnect/universal-provider": "2.23.10",
      "uuid": "^11.1.1",
      "sharp": "^0.35.0",
      "axios": "^1.18.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
